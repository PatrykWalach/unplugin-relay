{
  "name": "unplugin-relay",
  "version": "0.1.0",
  "description": "A plugin for relay",
  "keywords": [
    "astro",
    "astro-plugin",
    "astro-plugin-relay",
    "esbuild",
    "esbuild-plugin",
    "esbuild-plugin-relay",
    "farm",
    "farm-plugin",
    "farm-plugin-relay",
    "graphql",
    "graphql-relay",
    "nuxt",
    "nuxt-plugin",
    "nuxt-plugin-relay",
    "relay",
    "rolldown",
    "rolldown-plugin",
    "rolldown-plugin-relay",
    "rollup",
    "rollup-plugin",
    "rollup-plugin-relay",
    "rspack",
    "rspack-plugin",
    "rspack-plugin-relay",
    "typescript",
    "vite",
    "vite-plugin",
    "vite-plugin-relay",
    "webpack",
    "webpack-plugin",
    "webpack-plugin-relay"
  ],
  "homepage": "https://github.com/PatrykWalach/unplugin-relay#readme",
  "bugs": {
    "url": "https://github.com/PatrykWalach/unplugin-relay/issues"
  },
  "license": "MIT",
  "author": "Patryk Wałach <author.name@mail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatrykWalach/unplugin-relay.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./astro": "./dist/astro.mjs",
    "./esbuild": "./dist/esbuild.mjs",
    "./farm": "./dist/farm.mjs",
    "./nuxt": "./dist/nuxt.mjs",
    "./rolldown": "./dist/rolldown.mjs",
    "./rollup": "./dist/rollup.mjs",
    "./rspack": "./dist/rspack.mjs",
    "./types": "./dist/types.mjs",
    "./vite": "./dist/vite.mjs",
    "./webpack": "./dist/webpack.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "release": "bumpp --pr",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "oxc-transform-relay": "^0.147.0",
    "unplugin": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "bumpp": "11.1.0",
    "pkg-pr-new": "0.0.88",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@farmfe/core": ">=1",
    "@nuxt/kit": "^3",
    "@nuxt/schema": "^3",
    "esbuild": "*",
    "rollup": "^3",
    "vite": ">=3",
    "webpack": "^4 || ^5"
  },
  "peerDependenciesMeta": {
    "@farmfe/core": {
      "optional": true
    },
    "@nuxt/kit": {
      "optional": true
    },
    "@nuxt/schema": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  }
}
